# Backend used by production builds (`npm run build`). Vite embeds it into the
# bundle at build time, so it is public by nature; never put secrets here.
# Give the origin only: the API client appends /api/... itself.
# A VITE_API_URL set in the hosting platform's environment overrides this file.
VITE_API_URL=https://backend-tau-eight-78.vercel.app
